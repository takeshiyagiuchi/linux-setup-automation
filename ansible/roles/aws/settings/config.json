{
	"agent": {
		"metrics_collection_interval": 60,
		"run_as_user": "root"
	},
	"metrics": {
		"metrics_collected": {
			"cpu": {
				"measurement": [
					"cpu_usage_active"
				],
				"metrics_collection_interval": 60,
				"totalcpu": true
			},
			"disk": {
				"measurement": [
					"used_percent"
				],
				"metrics_collection_interval": 60,
				"resources": [
					"/"
				]
			},
			"mem": {
				"measurement": [
					"mem_used_percent"
				],
				"metrics_collection_interval": 60
			},
			"nvidia_gpu": {
                                "measurement": [
                                        "memory_total",
                                        "memory_used",
                                        "temperature_gpu",
                                        "power_draw"
                                ],
                                "metrics_collection_interval": 60
                        }
		}
	}
}
